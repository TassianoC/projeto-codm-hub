# Variáveis SOMENTE do servidor Vercel.
# Nunca coloque a chave real no app.js, index.html ou firebase-config.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Necessária para a Function conferir que a chamada do Coach veio de um usuário
# autenticado no Firebase. Use a mesma apiKey pública de firebase-config.js.
FIREBASE_WEB_API_KEY=

# Opcional: domínio do frontend se ele estiver separado da Vercel.
# ALLOWED_ORIGIN=https://seu-dominio.com
